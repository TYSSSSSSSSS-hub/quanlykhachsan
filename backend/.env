# ============================================================
#  Database Configuration (MySQL)
# ============================================================
# Thay đổi các giá trị bên dưới cho phù hợp với môi trường của bạn

# URL kết nối MySQL - đổi 'hotel_db' thành tên database của bạn
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hotel_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8

# Driver MySQL
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Tên đăng nhập MySQL (mặc định thường là 'root')
SPRING_DATASOURCE_USERNAME=root

# Mật khẩu MySQL của bạn
SPRING_DATASOURCE_PASSWORD=S1a2n3g4@2006

# ============================================================
#  JWT Configuration (tuỳ chọn, có thể bỏ trống nếu dùng giá trị mặc định)
